GOOGLE_WEB_CLIENT_ID  = ""
# Neon/PostgreSQL URL. Keep sslmode=require (the application also enforces it).
DATABASE_URL = "postgresql+psycopg2://user:password@ep-example-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"
JWT_SECRET_KEY= ""
APP_BASE_URL=http://localhost:5000
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudflare R2 S3-compatible storage.
R2_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_REGION="auto"
R2_BUCKET=""
# Public R2 custom domain or r2.dev URL used for uploaded file URLs.
R2_PUBLIC_URL=""
# Private bucket dedicated to challenge evidence videos.
R2_EVIDENCE_BUCKET="evidence"

FIREBASE_PROJECT_ID= ""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Chess.com public API integration. Use an identifiable contact address.
CHESS_COM_USER_AGENT="Nerdmaxxing/1.0 (contact: admin@example.com)"
CHESS_COM_API_TIMEOUT_SECONDS=8
CHESS_COM_CHALLENGE_TTL_MINUTES=15
CHESS_COM_MAX_CONFIRMATION_ATTEMPTS=5
CHESS_COM_RATING_CACHE_MINUTES=5
