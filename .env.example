# Required
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
DATABASE_URL=sqlite:///./nerdmaxxing.db
APP_BASE_URL=http://localhost:3000
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional Firebase Admin credentials for push notifications
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
# CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# FORCE_HTTPS=false
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
