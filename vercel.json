{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/policy/?",
      "dest": "/policy.html"
    },
    {
      "src": "/?",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}